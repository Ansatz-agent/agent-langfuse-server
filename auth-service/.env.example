DJANGO_ENV=production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret
DJANGO_ALLOWED_HOSTS=c2sml.cn,auth-service,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://c2sml.cn
TRACE_GATEWAY_INTERNAL_SECRET=replace-with-a-separate-high-entropy-service-secret
LANGFUSE_INTERNAL_BASE_URL=http://langfuse-web:3000/langfuse/api/public
LANGFUSE_PROJECT_PUBLIC_KEY=replace-with-owner-only-project-public-key
LANGFUSE_PROJECT_SECRET_KEY=replace-with-owner-only-project-secret-key
MEMORY_INTERNAL_TOKEN=replace-with-a-separate-high-entropy-memory-ui-token
HISTORY_IMPORT_MAX_BYTES=26214400
CLIENT_SESSION_LAST_SEEN_MIN_INTERVAL_SECONDS=60
CLIENT_SESSION_ISSUANCE_RATE_LIMIT=10
CLIENT_SESSION_ISSUANCE_RATE_WINDOW_SECONDS=3600
