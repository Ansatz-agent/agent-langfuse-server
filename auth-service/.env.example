DJANGO_ENV=production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret
DJANGO_ALLOWED_HOSTS=agent.c2sml.cn,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://agent.c2sml.cn
# Keep empty for a dedicated hostname; use /agent only for a reviewed path-prefix deployment.
DJANGO_SCRIPT_NAME=
DJANGO_SESSION_COOKIE_NAME=agent_history_sessionid
DJANGO_CSRF_COOKIE_NAME=agent_history_csrftoken
HISTORY_IMPORT_MAX_BYTES=26214400
